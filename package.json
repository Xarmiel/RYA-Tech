{
  "name": "rya-tech-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && .\\mvnw.cmd spring-boot:run",
    "dev:backend:sh": "cd backend && ./mvnw spring-boot:run",
    "dev:frontend": "cd frontend-angular/app && npm start",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:sh": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend:sh\" \"npm run dev:frontend\"",
    "build:backend": "cd backend && .\\mvnw.cmd clean package -DskipTests",
    "build:backend:sh": "cd backend && ./mvnw clean package -DskipTests",
    "build:frontend": "cd frontend-angular/app && npm run build",
    "build": "concurrently -n \"BUILD-BACKEND,BUILD-FRONTEND\" -c \"blue,green\" \"npm run build:backend\" \"npm run build:frontend\"",
    "build:sh": "concurrently -n \"BUILD-BACKEND,BUILD-FRONTEND\" -c \"blue,green\" \"npm run build:backend:sh\" \"npm run build:frontend\"",
    "test:backend": "cd backend && .\\mvnw.cmd test",
    "test:frontend": "cd frontend-angular/app && npm run test:ci",
    "test": "concurrently -n \"TEST-BACKEND,TEST-FRONTEND\" -c \"blue,green\" \"npm run test:backend\" \"npm run test:frontend\""
  },
  "dependencies": {
    "@supabase/server": "^1.9.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
