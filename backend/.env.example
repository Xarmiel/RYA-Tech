# ============================================================================
# RYA Tech Backend - Plantilla de Variables de Entorno
# Copia este archivo como .env para desarrollo local o configura estas variables
# en el panel de Render / PaaS para despliegue en producción.
# ============================================================================

# Perfil de Spring Boot (dev para local, prod para Render / producción)
SPRING_PROFILES_ACTIVE=dev

# Puerto del servidor (en Render se asigna automáticamente mediante $PORT)
PORT=8080

# ============================================================================
# Conexión Supabase PostgreSQL (Esquema obligatorio: rya)
# ============================================================================
# Para conexión vía Session / Transaction Pooler (puerto 5432 o 6543):
DB_URL=jdbc:postgresql://aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<PROJECT_REF>
DB_PASSWORD=tu_password_de_base_de_datos
DB_SCHEMA=rya

# Pool reducido para producción. Ajustar solo tras medir consumo y conexiones.
DB_POOL_MAX_SIZE=2
DB_POOL_MIN_IDLE=0

# ============================================================================
# Configuración CORS
# ============================================================================
# En desarrollo: http://localhost:4200,http://localhost:3000
# En producción (Render): solo https://tu-dominio-frontend.vercel.app, sin comodines.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4201

# ============================================================================
# Supabase Auth JWT (Validación pública sin service_role)
# ============================================================================
SUPABASE_JWT_ISSUER=https://<PROJECT_REF>.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://<PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json
# Solo true si la migración de borradores ya está aplicada en esa base.
APP_TECHNICAL_DRAFTS_ENABLED=false
# Contacto público opcional. WhatsApp: número internacional, solo dígitos.
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_HOURS=

# ============================================================================
# Mercado Pago: Checkout API con Orders (solo si probarás pagos con este backend)
# ============================================================================
# Origen: tu aplicación en Mercado Pago Developers > Prueba > Credenciales.
# Firma: Configuración de webhooks > Prueba > Order (Mercado Pago).
# Dejar vacías no impide desarrollar el catálogo; iniciar un pago devuelve 503.
# Las pruebas automatizadas usan HTTP simulado y no necesitan estas credenciales.
# Guía del equipo: ../docs/MANUAL_MERCADO_PAGO.md
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Valida el entorno de la respuesta; no convierte claves reales en claves de prueba.
MERCADOPAGO_LIVE_MODE=false
