# ============================================================================
# RYA Tech Frontend (Angular) - Variables de Entorno de Ejemplo
# ============================================================================

# URL base del Backend Spring Boot (en local se usa proxy relativo vacío '';
# para Vercel apuntando a Render se puede especificar ej: https://rya-tech-backend.onrender.com)
API_URL=

# Conexión Supabase (Auth / Client-side)
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=tu_clave_publica_publishable_o_anon

# El script de build lee variables del proceso, no carga este .env automáticamente.
# En Vercel configurarlas en Settings > Environment Variables.
# Nunca poner DB_PASSWORD ni service_role en este frontend.
