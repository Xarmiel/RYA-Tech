# ============================================================================
# RYA Tech - Configuración de Variables de Entorno del Proyecto
# Copia este archivo como .env para desarrollo local.
# NUNCA subas archivos .env con credenciales reales a GitHub.
# ============================================================================

# ==========================================
# Backend: Spring Boot & Base de Datos (Supabase)
# ==========================================
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Conexión JDBC PostgreSQL (Pooler Supabase)
DB_URL=jdbc:postgresql://aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<PROJECT_REF>
DB_PASSWORD=tu_password_de_base_de_datos
DB_SCHEMA=rya

# CORS permitido para frontend Angular
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# Supabase Auth JWKS (Verificación pública de JWT en backend)
SUPABASE_JWT_ISSUER=https://<PROJECT_REF>.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://<PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json

# ==========================================
# Frontend: Angular & Supabase Client
# ==========================================
# URL de la API backend (en dev se deja vacía para usar proxy.conf.json)
NG_APP_API_URL=
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=tu_public_anon_key

# ==========================================
# Pasarela de Pagos: Mercado Pago (Perú)
# ==========================================
MERCADOPAGO_PUBLIC_KEY=TEST-tu_public_key_aqui
MERCADOPAGO_ACCESS_TOKEN=TEST-tu_access_token_aqui
MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret_opcional


